NODE_ENV=production
PORT=3000
# Sign-in codes are emailed via Resend (resend.com). Locally, leave empty for TEST MODE (code shown on screen).
# In production, email sign-in is OFF until this is set; password login still works.
RESEND_API_KEY=
EMAIL_FROM=Find My Expense <login@findmyexpense.com>
# Where accounts are stored. On Fly.io, mount a volume at /data.
DATA_DIR=
# Optional. Signs login sessions; auto-generated and saved in DATA_DIR if empty.
SESSION_SECRET=
# Receipt scanning. Google Gemini free tier (preferred), or Claude. Leave both empty to hide the Scan a receipt option.
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
